# (.env file only)
NODE_ENV=development # development | staging | production

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gitcord # sqlite

# GitHub
GITHUB_APP_SLUG=gitcord-github-app
GITHUB_APP_ID=123456789012345678
GITHUB_CLIENT_ID=123456789012345678
GITHUB_CLIENT_SECRET=abcdef1234567890abcdef1234567890
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
your super long key from the .pem file goes here
-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=super-secret-webhook-key-change-me

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:3000/api/v1/auth/discord/callback

# Bot
BOT_WEBHOOK_URL=http://localhost:3001/webhook/server
BOT_WEBHOOK_SECRET=super-secret-webhook-key-change-me

# Dashboard
DASHBOARD_URL=http://localhost:3002

# NGrok
NGROK_AUTHTOKEN=2abc...your-ngrok-token-here
NGROK_URL=https://your-custom-subdomain.ngrok-free.app

# Tokenization & Security
JWT_SECRET=super-secure-jwt-secret-change-me
JWT_REFRESH_SECRET=super-secure-jwt-refresh-secret-change-me

# Base Networking
PORT=3000
BASE_URL=http://localhost:3000