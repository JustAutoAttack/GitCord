{
	"name": "gitcord-server",
	"version": "0.1.0",
	"description": "Remote TypeScript server for GitCord using Hono, Node.js, and Zod",
	"main": "dist/index.js",
	"scripts": {
		"dev": "NODE_ENV=development tsx watch src/index.ts",
		"start:prod": "NODE_ENV=production node dist/index.js",
		"build": "tsc --project tsconfig.app.json && tsc-alias",
		"typecheck": "tsc --project tsconfig.app.json --noEmit",
		"typecheck:test": "tsc --project tsconfig.test.json --noEmit",
		"generate:schema": "node scripts/generate-schema.ts",
		"generate:openapi": "tsx scripts/generate-openapi.ts",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@hono/node-server": "^1.12.0",
		"@hono/swagger-ui": "^0.5.0",
		"@hono/zod-openapi": "^0.18.3",
		"@hono/zod-validator": "^0.4.0",
		"better-sqlite3": "^13.0.3",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.6.0",
		"jsonwebtoken": "^9.0.3",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^9.6.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^22.0.0",
		"@vitest/coverage-v8": "^5.0.0",
		"drizzle-kit": "^0.31.10",
		"tsc-alias": "^1.9.1",
		"tsx": "^4.19.0",
		"typescript": "^5.5.0",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^5.0.0"
	}
}
