            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "guildId": {
                    "type": "string",
                    "minLength": 1,
                    "example": "123456789012345678"
                  },
                  "commandChannelId": {
                    "type": "string",
                    "minLength": 1,
                    "example": "123456789012345679"
                  },
                  "notificationChannelId": {
                    "type": "string",
                    "minLength": 1,
                    "example": "123456789012345680"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Repository configuration updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "cfg_123456"
                    },
                    "guildId": {
                      "type": "string",
                      "example": "123456789012345678"
                    },
                    "commandChannelId": {
                      "type": "string",
                      "example": "123456789012345679"
                    },
                    "notificationChannelId": {
                      "type": "string",
                      "example": "123456789012345680"
                    },
                    "updatedAt": {
                      "type": "string",
                      "example": "2026-08-17T14:30:00.000Z"
                    },
                    "createdAt": {
                      "type": "string",
                      "example": "2026-08-01T10:00:00.000Z"
                    }
                  },
                  "required": [
                    "id",
                    "guildId",
                    "commandChannelId",
                    "notificationChannelId",
                    "updatedAt",
                    "createdAt"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "404": {
            "description": "Repository configuration not found"
          }
        }
      },
      "delete": {
        "tags": [
          "Repo Configurations"
        ],
        "summary": "Delete repository configuration",
        "description": "Deletes an existing repository configuration.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Repo Configuration ID",
              "example": "cfg_123456"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Repository configuration deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Operation completed successfully"
                    }
                  },
                  "required": [
                    "success",
                    "message"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Repository configuration not found"
          }
        }
      }
    },
