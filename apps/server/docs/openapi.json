  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Liveness Probe",
        "description": "Immediate process responsiveness check.",
        "responses": {
          "200": {
            "description": "Server process response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Service is operational"
                    },
                    "timestamp": {
                      "type": "string",
                      "example": "2026-08-17T17:55:00.000Z"
                    },
                    "uptimeSeconds": {
                      "type": "number",
                      "example": 3600
                    },
                    "checks": {
                      "type": "object",
                      "properties": {
                        "database": {
                          "type": "object",
                          "properties": {
                            "success": {
                              "type": "boolean",
                              "example": true
                            },
                            "message": {
                              "type": "string",
                              "example": "Database connection is active and responsive"
                            },
                            "latencyMs": {
                              "type": "number",
                              "example": 0.82
                            }
                          },
                          "required": [
                            "success",
                            "message"
                          ]
                        }
                      },
                      "required": [
                        "database"
                      ]
                    }
                  },
                  "required": [
                    "success",
                    "message",
                    "timestamp"
                  ]
                }
              }
            }
          }
        }
      }
    },
