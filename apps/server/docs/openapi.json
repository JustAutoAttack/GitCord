              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "example": "cfg_123456"
                      },
                      "guildId": {
                        "type": "string",
                        "example": "123456789012345678"
                      },
                      "repositoryUrl": {
                        "type": "string",
                        "format": "uri",
