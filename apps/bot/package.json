{
	"name": "gitcord-bot",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"deploy:commands": "tsx scripts/deploy-commands.ts",
		"generate:tree": "tsx scripts/generate-tree.ts",
		"build": "tsup src/index.ts --format cjs --dts",
		"typecheck": "tsc --project tsconfig.app.json --noEmit"
	},
	"dependencies": {
		"@gitcord/logger": "file:../../packages/logger",
		"@gitcord/server-api": "file:../../packages/server-api",
		"@hono/node-server": "^1.13.0",
		"@hono/swagger-ui": "^0.5.3",
		"@hono/zod-openapi": "^0.18.3",
		"@ngrok/ngrok": "^1.7.0",
		"discord.js": "^14.27.0",
		"dotenv": "^16.4.5",
		"hono": "^4.5.11",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/node": "^20.14.10",
		"tsup": "^8.1.0",
		"tsx": "^4.16.2",
		"typescript": "^5.5.2"
	}
}